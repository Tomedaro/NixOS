{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",
  "permission": {
    "*": "ask",

    "read": {
      "*": "allow",
      "/tmp": "ask",
      "/tmp/*": "ask"
    },
    "write": {
      "*": "allow",
      "/tmp": "ask",
      "/tmp/*": "ask"
    },
    "edit": {
      "*": "allow",
      "/tmp": "ask",
      "/tmp/*": "ask"
    },

    "grep": "allow",
    "find": "allow",
    "ls": "allow",

    "path": {
      "*": "allow"
    },

    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/*": "allow"
    },

    "bash": {
      "*": "ask",
      "cd *": "allow",
      "pwd": "allow",
      "ls *": "allow",
      "find . *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "cat *": "allow",
      "sed -n *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "echo *": "allow",
      "git status --short": "allow",
      "git diff --stat": "allow",
      "git diff --check": "allow",
      "git branch --show-current": "allow",

      "nix eval --raw .#nixosConfigurations.Default.config.system.name": "allow",

      "cat ~/.ssh*": "deny",
      "cat ~/.gnupg*": "deny",
      "cat ~/.pi/agent/auth.json*": "deny",
      "grep -R . ~/.ssh*": "deny",
      "grep -R . ~/.gnupg*": "deny",
      "rg * ~/.ssh*": "deny",
      "rg * ~/.gnupg*": "deny",
      "rm -rf *": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "curl *|*": "deny",
      "wget *|*": "deny",
      "pi install*": "deny",
      "pi remove*": "deny",
      "pi uninstall*": "deny",
      "pi config*": "ask",
      "pi update*": "ask"
    },

    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow",
      "mcp_search": "allow",
      "mcp_describe": "allow",
      "nixos*": "allow",
      "nixos:*": "allow"
    },

    "skill": {
      "*": "ask"
    }
  }
}
